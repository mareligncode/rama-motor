# ==========================================
# Rama Delivery Backend Environment Config (.env.example)
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/rama_delivery

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# SMS Ethiopia API Configuration (For OTP & SMS Notifications)
# API documentation & key from https://smsethiopia.com
SMS_ETHIOPIA_API_KEY=YOUR_SMS_ETHIOPIA_API_KEY
SMS_ETHIOPIA_URL=https://smsethiopia.com/api/sms/send

# Push Notifications (Expo Push API)
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Email Service (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-digit-app-password
EMAIL_FROM="Rama Delivery" <no-reply@ramadelivery.et>

# Fayda National ID Program (eSignet OIDC & Partner Integration)
# Documentation: https://partner.fayda.et/docs
FAYDA_CLIENT_ID=aQ7xN2kLm9_Vp4RzT8cY-hW3sJ6FdE0uXbKqP1
FAYDA_REDIRECT_URI=http://localhost:3000/callback
FAYDA_AUTHORIZATION_ENDPOINT=https://esignet.ida.fayda.et/authorize
FAYDA_TOKEN_ENDPOINT=https://esignet.ida.fayda.et/v1/esignet/oauth/v2/token
FAYDA_USERINFO_ENDPOINT=https://esignet.ida.fayda.et/v1/esignet/oidc/userinfo
FAYDA_PRIVATE_KEY=
